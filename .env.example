# All settings are optional — the CPU-only table reproduction needs none of
# them. Fill in only what your workflow uses.

# HuggingFace cache (open-source models download here)
HF_HOME=

# Neo4j (only for the index-parity ablation / production-stack replication)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_LOCAL_URI=bolt://localhost:7687
NEO4J_LOCAL_PASSWORD=

# Commercial backbones (cross-backbone table only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
